---
---

<section id="facilities" class="py-20 bg-gradient-to-b from-gray-50 to-white">
  <div class="container mx-auto px-6">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">Nuestras Instalaciones</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-purple-600 to-blue-500 mx-auto mb-6"></div>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Un espacio de calidad diseñado para garantizar la seguridad, salud y comodidad de los voluntarios
      </p>
    </div>

    <!-- Location -->
    <div class="max-w-4xl mx-auto mb-16 bg-white rounded-3xl shadow-xl p-8 md:p-12">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="flex-shrink-0">
          <div class="w-20 h-20 gradient-bg rounded-2xl flex items-center justify-center">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
        </div>
        <div class="flex-1 text-center md:text-left">
          <h3 class="text-2xl font-bold text-gray-800 mb-2">Ubicación Estratégica</h3>
          <p class="text-gray-600 text-lg">
            Av. Alemania 1361, Col. Moderna, C.P. 44190<br>
            Guadalajara, Jalisco, México
          </p>
          <p class="text-gray-500 mt-2">
            Ubicados en una zona central de la ciudad de Guadalajara con fácil acceso
          </p>
        </div>
      </div>
    </div>

    <!-- Capacity Info -->
    <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto mb-16">
      <div class="bg-gradient-to-br from-purple-600 to-blue-500 rounded-3xl p-8 text-white shadow-xl">
        <div class="text-5xl font-bold mb-4">8</div>
        <div class="text-xl font-semibold mb-2">Estudios por Mes</div>
        <p class="text-white/90">
          Capacidad para conducir hasta 8 estudios clínicos cada mes
        </p>
      </div>
      <div class="bg-gradient-to-br from-blue-500 to-purple-600 rounded-3xl p-8 text-white shadow-xl">
        <div class="text-5xl font-bold mb-4">4</div>
        <div class="text-xl font-semibold mb-2">Ensayos Simultáneos</div>
        <p class="text-white/90">
          Capacidad de coordinación y ejecución de hasta 4 ensayos al mismo tiempo
        </p>
      </div>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto">
      <!-- Feature 1 -->
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-800 mb-2">Archivo Clínico Seguro</h4>
            <p class="text-gray-600 text-sm">Con acceso controlado y equipo de seguridad especializado</p>
          </div>
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-800 mb-2">4 Consultorios Médicos</h4>
            <p class="text-gray-600 text-sm">Espacios equipados para atención médica especializada</p>
          </div>
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-800 mb-2">Sala de Electrocardiogramas</h4>
            <p class="text-gray-600 text-sm">Equipamiento especializado para estudios cardíacos</p>
          </div>
        </div>
      </div>

      <!-- Feature 4 -->
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-800 mb-2">Almacén de Medicamentos</h4>
            <p class="text-gray-600 text-sm">Con acceso y condiciones ambientales controladas</p>
          </div>
        </div>
      </div>

      <!-- Feature 5 -->
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-800 mb-2">4 Recámaras Independientes</h4>
            <p class="text-gray-600 text-sm">Capacidad para alojar hasta 20 voluntarios cada una (80 en total)</p>
          </div>
        </div>
      </div>

      <!-- Feature 6 -->
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-800 mb-2">2 Áreas de Recreación</h4>
            <p class="text-gray-600 text-sm">Espacios de esparcimiento para comodidad de voluntarios</p>
          </div>
        </div>
      </div>

      <!-- Feature 7 -->
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-800 mb-2">2 Salas de Urgencias</h4>
            <p class="text-gray-600 text-sm">Equipadas con carros de paro para emergencias médicas</p>
          </div>
        </div>
      </div>

      <!-- Feature 8 -->
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-800 mb-2">Vigilancia 24/7</h4>
            <p class="text-gray-600 text-sm">Monitoreo continuo mediante circuito cerrado de televisión</p>
          </div>
        </div>
      </div>

      <!-- Feature 9 -->
      <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all duration-300">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-800 mb-2">Comités de Ética e Investigación</h4>
            <p class="text-gray-600 text-sm">Revisión y aprobación ética de todos los protocolos</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="max-w-4xl mx-auto mt-16 text-center">
      <p class="text-xl text-gray-600 mb-8">
        Nuestro propósito es garantizar una experiencia integral digna tanto para los voluntarios como para nuestro personal, con uno de los más altos niveles de atención y servicio al cliente.
      </p>
      <a href="#contact" class="inline-block gradient-bg text-white px-10 py-4 rounded-full font-semibold text-lg hover:shadow-2xl hover:scale-105 transition-all duration-300">
        Conoce Más Sobre Nuestras Instalaciones
      </a>
    </div>
  </div>
</section>