---

---

<section id="services" class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">
        Nuestros Servicios
      </h2>
      <div
        class="w-24 h-1 bg-gradient-to-r from-purple-600 to-blue-500 mx-auto mb-6"
      >
      </div>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Ofrecemos a nuestros clientes una amplia gama de ensayos clínicos para
        verificar la seguridad y eficacia de consumibles para las industrias de
        salud y consumo humano
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
      <!-- Service 1 -->
      <div
        class="group bg-gradient-to-br from-purple-50 to-blue-50 rounded-3xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2"
      >
        <div
          class="w-16 h-16 gradient-bg rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
            ></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-4">
          Estudios de Bioequivalencia y Biodisponibilidad
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Evaluamos la equivalencia terapéutica entre formulaciones
          farmacéuticas mediante estudios comparativos rigurosos.
        </p>
      </div>

      <!-- Service 2 -->
      <div
        class="group bg-gradient-to-br from-purple-50 to-blue-50 rounded-3xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2"
      >
        <div
          class="w-16 h-16 gradient-bg rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
            ></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-4">
          Ensayos Clínicos Fase I, II, III, IV
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Coordinación completa de ensayos clínicos en todas sus fases, desde la
          evaluación inicial hasta estudios post-comercialización.
        </p>
      </div>

      <!-- Service 3 -->
      <div
        class="group bg-gradient-to-br from-purple-50 to-blue-50 rounded-3xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2"
      >
        <div
          class="w-16 h-16 gradient-bg rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            ></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-4">
          Estudios Farmacocinéticos
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Análisis detallado de absorción, distribución, metabolismo y excreción
          de fármacos en el organismo.
        </p>
      </div>

      <!-- Service 4 -->
      <div
        class="group bg-gradient-to-br from-purple-50 to-blue-50 rounded-3xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2"
      >
        <div
          class="w-16 h-16 gradient-bg rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
            ></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-4">
          Estudios de Biodisponibilidad Comparativa
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Evaluación de productos sin interacción para determinar la
          biodisponibilidad relativa entre formulaciones.
        </p>
      </div>

      <!-- Service 5 -->
      <div
        class="group bg-gradient-to-br from-purple-50 to-blue-50 rounded-3xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2"
      >
        <div
          class="w-16 h-16 gradient-bg rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            ></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-4">
          Estudios de Farmacovigilancia
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Monitoreo continuo de la seguridad de medicamentos para identificar y
          evaluar efectos adversos.
        </p>
      </div>

      <!-- Service 6 -->
      <div
        class="group bg-gradient-to-br from-purple-50 to-blue-50 rounded-3xl p-8 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2"
      >
        <div
          class="w-16 h-16 gradient-bg rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
            ></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-4">
          Estudios Observacionales
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Investigación de efectos y resultados en condiciones de práctica
          clínica habitual sin intervención experimental.
        </p>
      </div>
    </div>

    <!-- Industries Served -->
    <div class="mt-20 max-w-5xl mx-auto">
      <div
        class="bg-gradient-to-r from-purple-600 to-blue-500 rounded-3xl p-12"
      >
        <h3 class="text-3xl font-bold text-white text-center mb-8">
          Industrias que Servimos
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 text-center hover:bg-white/20 transition-all duration-300"
          >
            <div class="text-white text-lg font-semibold">Médica</div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 text-center hover:bg-white/20 transition-all duration-300"
          >
            <div class="text-white text-lg font-semibold">Cosmética</div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 text-center hover:bg-white/20 transition-all duration-300"
          >
            <div class="text-white text-lg font-semibold">Alimentaria</div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 text-center hover:bg-white/20 transition-all duration-300"
          >
            <div class="text-white text-lg font-semibold">Nutricional</div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 text-center hover:bg-white/20 transition-all duration-300"
          >
            <div class="text-white text-lg font-semibold">Textil</div>
          </div>
          <div
            class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 text-center hover:bg-white/20 transition-all duration-300 col-span-2 md:col-span-3"
          >
            <div class="text-white text-lg font-semibold">
              Otras Relacionadas
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
