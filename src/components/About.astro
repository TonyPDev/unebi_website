---

---

<section
  id="about"
  class="py-24 relative overflow-hidden bg-gradient-to-b from-white via-purple-50/50 to-white reveal-on-scroll"
>
  <div
    class="absolute top-0 right-0 w-[600px] h-[600px] bg-purple-200/20 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/2 -z-10"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue-200/20 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/2 -z-10"
  >
  </div>

  <div
    class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(#4b5563_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none -z-10"
  >
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="container mx-auto px-6 relative z-10">
      <div
        class="absolute inset-0 opacity-[0.03]"
        style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%239C92AC\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
      >
      </div>

      <div
        class="absolute top-0 right-0 w-[800px] h-[800px] bg-purple-100/40 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/2"
      >
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center mb-24">
          <div>
            <span
              class="inline-block py-1 px-3 rounded-full bg-purple-100 text-purple-700 text-xs font-bold tracking-wider mb-4 uppercase"
              >Sobre Nosotros</span
            >
            <h2
              class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6 leading-tight"
            >
              Líderes en <span class="text-purple-700">Investigación</span><span
                class="text-blue-600"
              >
                Clínica</span
              >
            </h2>
            <p class="text-lg text-gray-600 leading-relaxed mb-6 font-medium">
              UNEBI se ha consolidado como una Organización de Investigación por
              Contrato (CRO) de referencia, especializada en estudios de
              Bioequivalencia y Ensayos Clínicos Fase I-IV.
            </p>
            <p class="text-gray-600 leading-relaxed mb-8">
              Desde nuestra fundación en 2009, hemos combinado excelencia
              científica con un trato humano excepcional, garantizando
              resultados precisos y la seguridad absoluta de nuestros
              voluntarios.
            </p>

            <div class="grid grid-cols-2 gap-6">
              <div
                class="p-4 bg-white rounded-2xl shadow-md border border-purple-50 transform transition-all duration-300 hover:scale-110 hover:shadow-xl hover:border-purple-200 cursor-default group"
              >
                <div
                  class="text-3xl font-bold text-purple-700 mb-1 group-hover:scale-105 transition-transform"
                >
                  +15
                </div>
                <div class="text-sm text-gray-500 font-medium">
                  Años de Trayectoria
                </div>
              </div>

              <div
                class="p-4 bg-white rounded-2xl shadow-md border border-purple-50 transform transition-all duration-300 hover:scale-110 hover:shadow-xl hover:border-blue-200 cursor-default group"
              >
                <div
                  class="text-3xl font-bold text-blue-600 mb-1 group-hover:scale-105 transition-transform"
                >
                  100%
                </div>
                <div class="text-sm text-gray-500 font-medium">
                  Cumplimiento Normativo
                </div>
              </div>
            </div>
          </div>

          <div class="relative group perspective-1000">
            <div
              class="absolute inset-0 bg-gradient-to-tr from-purple-600 to-blue-500 rounded-[2rem] rotate-3 opacity-20 transform translate-x-2 translate-y-2 transition-transform duration-500 group-hover:rotate-6 group-hover:scale-105"
            >
            </div>

            <div
              class="bg-white rounded-[2rem] p-8 md:p-10 shadow-2xl relative z-10 border border-purple-100 transform transition-all duration-500 hover:scale-105 hover:shadow-purple-200/50 cursor-default"
            >
              <h3
                class="text-2xl font-bold text-gray-900 mb-6 border-b border-gray-100 pb-4"
              >
                Nuestra Misión
              </h3>

              <div class="flex gap-4 mb-6 group/item">
                <div
                  class="w-12 h-12 rounded-full bg-purple-100 flex items-center justify-center flex-shrink-0 text-purple-600 transition-transform duration-300 group-hover/item:scale-110 group-hover/item:bg-purple-600 group-hover/item:text-white"
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                  >
                </div>
                <div>
                  <h4 class="font-bold text-gray-800">Control de calidad</h4>
                  <p class="text-sm text-gray-600 mt-1">
                    Servir a nuestros clientes con pasión y calidad para
                    contribuir a garantizar la seguridad y eficacia de los
                    medicamentos e insumos para la salud que se distribuyen
                    entre la población, colaborando así en la generación de
                    bienestar en nuestra sociedad.
                  </p>
                </div>
              </div>

              <div class="flex gap-4 group/item">
                <div
                  class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0 text-blue-600 transition-transform duration-300 group-hover/item:scale-110 group-hover/item:bg-blue-600 group-hover/item:text-white"
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path></svg
                  >
                </div>
                <div>
                  <h4 class="font-bold text-gray-800">
                    Seguridad del Paciente
                  </h4>
                  <p class="text-sm text-gray-600 mt-1">
                    Protocolos estrictos bajo normatividad COFEPRIS para la
                    protección integral de los voluntarios.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="max-w-5xl mx-auto relative mb-24">
        <div
          class="absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-gradient-to-b from-purple-200 via-purple-400 to-purple-200 hidden md:block rounded-full"
        >
        </div>

        <div class="space-y-16">
          <div
            class="flex flex-col md:flex-row items-center gap-10 relative z-10 group"
          >
            <div
              class="flex-shrink-0 w-32 h-32 bg-white rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(124,58,237,0.3)] border-4 border-purple-500 relative z-20 group-hover:scale-110 transition-transform duration-500"
            >
              <span class="text-3xl font-black text-purple-800">2009</span>
            </div>

            <div
              class="flex-1 bg-white/80 backdrop-blur-sm rounded-3xl p-8 shadow-xl border border-purple-100 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 relative"
            >
              <div
                class="absolute top-4 right-4 w-10 h-10 bg-purple-50 rounded-full flex items-center justify-center text-purple-600"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                  ></path></svg
                >
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-3">Fundación</h3>
              <p class="text-gray-600 leading-relaxed">
                El Dr. Héctor Manuel González Martínez fundó UNEBI con la visión
                de proporcionar un servicio integral de clase mundial para la
                conducción de Estudios Clínicos en México.
              </p>
            </div>
          </div>

          <div
            class="flex flex-col md:flex-row-reverse items-center gap-10 relative z-10 group"
          >
            <div
              class="flex-shrink-0 w-32 h-32 bg-white rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(37,99,235,0.3)] border-4 border-blue-500 relative z-20 group-hover:scale-110 transition-transform duration-500"
            >
              <span class="text-3xl font-black text-blue-800">2011</span>
            </div>
            <div
              class="flex-1 bg-white/80 backdrop-blur-sm rounded-3xl p-8 shadow-xl border border-blue-100 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 text-right md:text-left relative"
            >
              <div
                class="absolute top-4 left-4 md:left-auto md:right-4 w-10 h-10 bg-blue-50 rounded-full flex items-center justify-center text-blue-600"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path></svg
                >
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-3">
                Autorización COFEPRIS
              </h3>
              <p class="text-gray-600 leading-relaxed">
                Hito crucial: Obtuvimos la autorización oficial para realizar
                estudios de intercambiabilidad, cumpliendo con los más altos
                estándares regulatorios.
              </p>
            </div>
          </div>

          <div
            class="flex flex-col md:flex-row items-center gap-10 relative z-10 group"
          >
            <div
              class="flex-shrink-0 w-32 h-32 bg-white rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(124,58,237,0.3)] border-4 border-purple-500 relative z-20 group-hover:scale-110 transition-transform duration-500"
            >
              <span class="text-3xl font-black text-purple-800">2016</span>
            </div>
            <div
              class="flex-1 bg-white/80 backdrop-blur-sm rounded-3xl p-8 shadow-xl border border-purple-100 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 relative"
            >
              <div
                class="absolute top-4 right-4 w-10 h-10 bg-purple-50 rounded-full flex items-center justify-center text-purple-600"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                  ></path></svg
                >
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-3">
                Nuevas Instalaciones
              </h3>
              <p class="text-gray-600 leading-relaxed">
                Crecimiento estratégico: Inauguración de instalaciones modernas
                en zona céntrica de Guadalajara, duplicando nuestra capacidad
                operativa.
              </p>
            </div>
          </div>

          <div
            class="flex flex-col md:flex-row-reverse items-center gap-10 relative z-10 group"
          >
            <div
              class="flex-shrink-0 w-32 h-32 bg-white rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(37,99,235,0.3)] border-4 border-blue-500 relative z-20 group-hover:scale-110 transition-transform duration-500"
            >
              <span class="text-3xl font-black text-blue-800">2018</span>
            </div>
            <div
              class="flex-1 bg-white/80 backdrop-blur-sm rounded-3xl p-8 shadow-xl border border-blue-100 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 text-right md:text-left relative"
            >
              <div
                class="absolute top-4 left-4 md:left-auto md:right-4 w-10 h-10 bg-blue-50 rounded-full flex items-center justify-center text-blue-600"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                  ></path></svg
                >
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-3">
                Expansión de Servicios
              </h3>
              <p class="text-gray-600 leading-relaxed">
                Consolidación de la unidad para la coordinación de Ensayos
                Clínicos Fase I-IV y establecimiento de alianzas estratégicas
                con hospitales.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="max-w-5xl mx-auto bg-gradient-to-r from-blue-900 via-indigo-900 to-blue-900 rounded-[2.5rem] p-12 text-center shadow-2xl relative overflow-hidden group hover:scale-[1.02] transition-transform duration-500"
      >
        <div
          class="absolute top-0 right-0 w-96 h-96 bg-white opacity-5 rounded-full -mr-20 -mt-20 group-hover:scale-110 transition-transform duration-700"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 w-64 h-64 bg-white opacity-5 rounded-full -ml-10 -mb-10 group-hover:scale-110 transition-transform duration-700"
        >
        </div>

        <div class="relative z-10">
          <h3
            class="text-3xl md:text-4xl font-bold text-white mb-8 tracking-tight"
          >
            Nuestro Compromiso
          </h3>

          <div
            class="text-2xl md:text-3xl text-purple-100 leading-relaxed font-light italic relative px-8"
          >
            <span
              class="absolute top-0 left-0 text-6xl text-blue-500 opacity-30 -translate-y-4"
              >"</span
            >
            Proporcionar servicios de <span
              class="text-white font-bold not-italic bg-blue-800/50 px-2 rounded"
              >calidad, confianza y velocidad</span
            > para acreditar la seguridad y eficacia de productos de salud.
            <span
              class="absolute bottom-0 right-0 text-6xl text-blue-500 opacity-30 translate-y-8"
              >"</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
