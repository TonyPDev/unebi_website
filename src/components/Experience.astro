      >
        <h4
          class="font-bold text-blue-800 mb-4 text-xl flex items-center gap-2"
        >
          <span class="w-2 h-8 bg-blue-400 rounded-full"></span>
          Antidiabéticos
        </h4>
        <div class="flex flex-wrap gap-2">
          {
            ["Metformina", "Glibenclamida", "Sitagliptina"].map((active) => (
              <span class="bg-white border border-blue-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium hover:scale-110 hover:bg-blue-100 hover:text-blue-800 hover:shadow-sm transition-all duration-300 cursor-default">
                {active}
              </span>
            ))
          }
        </div>
      </div>

      <div
        class="bg-cyan-50 rounded-2xl p-8 hover:bg-white hover:shadow-lg hover:border-cyan-200 border border-transparent transition-all duration-300 group"
      >
        <h4
          class="font-bold text-cyan-800 mb-4 text-xl flex items-center gap-2"
        >
          <span class="w-2 h-8 bg-cyan-500 rounded-full"></span>
          SNC / Psiquiátricos
        </h4>
        <div class="flex flex-wrap gap-2">
          {
            ["Sertralina", "Clonazepam", "Pregabalina"].map((active) => (
              <span class="bg-white border border-cyan-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium hover:scale-110 hover:bg-cyan-100 hover:text-cyan-800 hover:shadow-sm transition-all duration-300 cursor-default">
                {active}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-12 text-center">
      <button
        id="open-cases-modal"
        class="bg-cyan-600 text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg shadow-cyan-200 hover:bg-cyan-700 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 inline-flex items-center gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
          ></path>
