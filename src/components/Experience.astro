<section id="experience" class="py-20 bg-white relative">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-cyan-900 mb-4">
        Nuestra Experiencia
      </h2>
      <div class="w-24 h-1 bg-cyan-600 mx-auto mb-6"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-20">
      <div
        class="bg-white rounded-3xl p-10 text-center shadow-lg border border-cyan-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
      >
        <div
          class="text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-700 to-blue-600 mb-4 group-hover:scale-110 transition-transform duration-300 inline-block"
        >
          400+
        </div>
        <div class="text-xl text-gray-800 font-bold mb-2">
          Estudios Clínicos
        </div>
        <p class="text-gray-500">Realizados desde 2011</p>
      </div>

      <div
        class="bg-white rounded-3xl p-10 text-center shadow-lg border border-cyan-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
      >
        <div
          class="text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-700 mb-4 group-hover:scale-110 transition-transform duration-300 inline-block"
        >
          700+
        </div>
        <div class="text-xl text-gray-800 font-bold mb-2">
          Protocolos Diseñados
        </div>
        <p class="text-gray-500">Autorizados por COFEPRIS</p>
      </div>

      <div
        class="bg-white rounded-3xl p-10 text-center shadow-lg border border-cyan-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
