---
---

<section id="experience" class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <!-- Section Title -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">Nuestra Experiencia</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-purple-600 to-blue-500 mx-auto mb-6"></div>
    </div>

    <!-- Main Stats -->
    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-20">
      <div class="bg-gradient-to-br from-purple-600 to-blue-500 rounded-3xl p-10 text-center shadow-2xl hover:scale-105 transition-transform duration-300">
        <div class="text-6xl font-bold text-white mb-4">400+</div>
        <div class="text-xl text-white font-semibold mb-2">Estudios Clínicos</div>
        <p class="text-white/90">Realizados desde 2011</p>
      </div>
      <div class="bg-gradient-to-br from-blue-500 to-purple-600 rounded-3xl p-10 text-center shadow-2xl hover:scale-105 transition-transform duration-300">
        <div class="text-6xl font-bold text-white mb-4">700+</div>
        <div class="text-xl text-white font-semibold mb-2">Protocolos Diseñados</div>
        <p class="text-white/90">Autorizados por COFEPRIS</p>
      </div>
      <div class="bg-gradient-to-br from-purple-500 to-blue-600 rounded-3xl p-10 text-center shadow-2xl hover:scale-105 transition-transform duration-300">
        <div class="text-6xl font-bold text-white mb-4">10+</div>
        <div class="text-xl text-white font-semibold mb-2">Años de Experiencia</div>
        <p class="text-white/90">Ininterrumpida en el sector</p>
      </div>
    </div>

    <!-- Team Experience -->
    <div class="max-w-4xl mx-auto mb-20 bg-gradient-to-r from-gray-50 to-white rounded-3xl p-12 shadow-xl">
      <h3 class="text-3xl font-bold text-gray-800 mb-6 text-center">Nuestro Equipo</h3>
      <p class="text-xl text-gray-700 text-center leading-relaxed">
        El personal técnico de UNEBI es el mayor valor de la organización. Suman más de 10 años de experiencia ininterrumpida en el sector salud y farmacéutico, garantizando servicios de la más alta calidad.
      </p>
    </div>

    <!-- Success Stories Title -->
    <div class="text-center mb-12">
      <h3 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Casos de Éxito</h3>
      <p class="text-lg text-gray-600">Hemos trabajado con más de 200 principios activos diferentes</p>
    </div>

    <!-- Active Principles Categories -->
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Category Pills -->
      <div class="bg-purple-50 rounded-2xl p-6 hover:shadow-lg transition-all duration-300">
        <h4 class="font-bold text-purple-700 mb-3 text-lg">Antivirales</h4>
        <div class="flex flex-wrap gap-2">
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Abacavir</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Lamivudine</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Zidovudine</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Efavirenz</span>
        </div>
      </div>

      <div class="bg-blue-50 rounded-2xl p-6 hover:shadow-lg transition-all duration-300">
        <h4 class="font-bold text-blue-700 mb-3 text-lg">Cardiovasculares</h4>
        <div class="flex flex-wrap gap-2">
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Amlodipine</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Atorvastatin</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Simvastatin</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Losartan</span>
        </div>
      </div>

      <div class="bg-indigo-50 rounded-2xl p-6 hover:shadow-lg transition-all duration-300">
        <h4 class="font-bold text-indigo-700 mb-3 text-lg">Antibióticos</h4>
        <div class="flex flex-wrap gap-2">
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Amoxicillin</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Ciprofloxacin</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Cephalexin</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Azithromycin</span>
        </div>
      </div>

      <div class="bg-violet-50 rounded-2xl p-6 hover:shadow-lg transition-all duration-300">
        <h4 class="font-bold text-violet-700 mb-3 text-lg">Antiinflamatorios</h4>
        <div class="flex flex-wrap gap-2">
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Ibuprofen</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Diclofenac</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Celecoxib</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Meloxicam</span>
        </div>
      </div>

      <div class="bg-purple-50 rounded-2xl p-6 hover:shadow-lg transition-all duration-300">
        <h4 class="font-bold text-purple-700 mb-3 text-lg">Antidiabéticos</h4>
        <div class="flex flex-wrap gap-2">
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Metformin</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Glibenclamide</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Sitagliptin</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Pioglitazone</span>
        </div>
      </div>

      <div class="bg-blue-50 rounded-2xl p-6 hover:shadow-lg transition-all duration-300">
        <h4 class="font-bold text-blue-700 mb-3 text-lg">SNC y Psiquiátricos</h4>
        <div class="flex flex-wrap gap-2">
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Sertraline</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Clonazepam</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Gabapentin</span>
          <span class="bg-white px-3 py-1 rounded-full text-sm text-gray-700">Pregabalin</span>
        </div>
      </div>
    </div>

    <!-- Main Clients -->
    <div class="mt-20 max-w-6xl mx-auto">
      <h3 class="text-3xl font-bold text-center text-gray-800 mb-12">Principales Clientes</h3>
      <div class="bg-gradient-to-br from-purple-600 to-blue-500 rounded-3xl p-12 shadow-2xl">
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 items-center">
          <div class="bg-white rounded-xl p-4 h-20 flex items-center justify-center hover:scale-105 transition-transform duration-300">
            <span class="text-gray-400 font-semibold">PISA</span>
          </div>
          <div class="bg-white rounded-xl p-4 h-20 flex items-center justify-center hover:scale-105 transition-transform duration-300">
            <span class="text-gray-400 font-semibold">Grisi</span>
          </div>
          <div class="bg-white rounded-xl p-4 h-20 flex items-center justify-center hover:scale-105 transition-transform duration-300">
            <span class="text-gray-400 font-semibold">Grupo Roche</span>
          </div>
          <div class="bg-white rounded-xl p-4 h-20 flex items-center justify-center hover:scale-105 transition-transform duration-300">
            <span class="text-gray-400 font-semibold">Boehringer</span>
          </div>
          <div class="bg-white rounded-xl p-4 h-20 flex items-center justify-center hover:scale-105 transition-transform duration-300">
            <span class="text-gray-400 font-semibold">Sanofi</span>
          </div>
          <div class="bg-white rounded-xl p-4 h-20 flex items-center justify-center hover:scale-105 transition-transform duration-300">
            <span class="text-gray-400 font-semibold">Y más...</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Quality Commitment -->
    <div class="max-w-4xl mx-auto mt-20 text-center">
      <div class="bg-gradient-to-r from-gray-50 to-white rounded-3xl p-12 shadow-xl">
        <svg class="w-16 h-16 mx-auto mb-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
        </svg>
        <h3 class="text-3xl font-bold text-gray-800 mb-4">Compromiso con la Calidad</h3>
        <p class="text-xl text-gray-700 leading-relaxed">
          Nuestro sistema está fundado en las mejores prácticas clínicas y regulaciones nacionales e internacionales, garantizando estudios de la más alta calidad que permiten acreditar la seguridad y eficacia de productos de salud y consumo humano.
        </p>
      </div>
    </div>
  </div>
</section>