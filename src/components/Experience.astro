<script define:vars={{ allSuccessCases }}>
  // Elementos DOM
  const modal = document.getElementById("cases-modal");
  const backdrop = document.getElementById("cases-backdrop");
  const panel = document.getElementById("cases-panel");
  const openBtn = document.getElementById("open-cases-modal");
  const closeBtns = [
    document.getElementById("close-cases-modal"),
    document.getElementById("close-cases-btn"),
  ];
  const searchInput = document.getElementById("case-search");
  const casesGrid = document.getElementById("cases-grid");
  const noResults = document.getElementById("no-results");
  const countLabel = document.getElementById("cases-count");

  // Referencia al Header (para ocultarlo)
  const siteHeader = document.querySelector("header");

  // Renderizar lista inicial
  function renderCases(filterText = "") {
    casesGrid.innerHTML = "";
    const lowerFilter = filterText.toLowerCase();

    const filtered = allSuccessCases.filter((c) =>
      c.toLowerCase().includes(lowerFilter),
    );

    // Actualizar contador
    countLabel.innerText = `${filtered.length} ${filtered.length === 1 ? "activo encontrado" : "activos encontrados"}`;

    if (filtered.length === 0) {
      casesGrid.classList.add("hidden");
      noResults.classList.remove("hidden");
    } else {
      casesGrid.classList.remove("hidden");
      noResults.classList.add("hidden");

      filtered.forEach((text) => {
        const div = document.createElement("div");
        div.className =
          "bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-gray-700 font-medium hover:bg-cyan-50 hover:border-cyan-200 hover:text-cyan-800 transition-colors cursor-default text-sm flex items-center gap-2";
        div.innerHTML = `
                <svg class="w-2 h-2 text-cyan-500 flex-shrink-0" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3" /></svg>
                ${text}
              `;
        casesGrid.appendChild(div);
      });
    }
  }

  function openModal() {
    renderCases(""); // Reiniciar lista
    searchInput.value = "";

    if (siteHeader) {
      siteHeader.style.transition = "opacity 0.3s";
      siteHeader.style.opacity = "0";
      siteHeader.style.pointerEvents = "none";
    }

    modal.classList.remove("hidden");
    setTimeout(() => {
      backdrop.classList.remove("opacity-0");
      panel.classList.remove("opacity-0", "scale-95");
      panel.classList.add("scale-100");
    }, 10);

    document.body.style.overflow = "hidden";

    // Enfocar buscador después de la animación
    setTimeout(() => {
      searchInput.focus();
    }, 100);
  }

  function closeModal() {
    backdrop.classList.add("opacity-0");
    panel.classList.remove("scale-100");
    panel.classList.add("opacity-0", "scale-95");

    if (siteHeader) {
      siteHeader.style.opacity = "1";
      siteHeader.style.pointerEvents = "auto";
    }

    setTimeout(() => {
      modal.classList.add("hidden");
      document.body.style.overflow = "";
    }, 300);
  }

  // Event Listeners
  openBtn?.addEventListener("click", openModal);
  closeBtns.forEach((btn) => btn?.addEventListener("click", closeModal));

  // Buscador en tiempo real
  searchInput?.addEventListener("input", (e) => {
    renderCases(e.target.value);
  });

  // Cerrar con ESC
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });
</script>

