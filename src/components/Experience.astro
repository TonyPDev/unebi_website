        </div>
      </div>

      <div
        class="bg-cyan-50 rounded-2xl p-8 hover:bg-white hover:shadow-lg hover:border-cyan-200 border border-transparent transition-all duration-300 group"
      >
        <h4
          class="font-bold text-cyan-900 mb-4 text-xl flex items-center gap-2"
        >
          <span class="w-2 h-8 bg-cyan-700 rounded-full"></span>
          Antibióticos
        </h4>
        <div class="flex flex-wrap gap-2">
          {
            ["Amoxicilina", "Ciprofloxacino", "Azitromicina"].map((active) => (
              <span class="bg-white border border-cyan-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium hover:scale-110 hover:bg-cyan-100 hover:text-cyan-900 hover:shadow-sm transition-all duration-300 cursor-default">
                {active}
              </span>
            ))
          }
        </div>
      </div>

      <div
