        </h4>
        <div class="flex flex-wrap gap-2">
          {
            ["Ibuprofeno", "Diclofenaco", "Celecoxib"].map((active) => (
              <span class="bg-white border border-cyan-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium hover:scale-110 hover:bg-cyan-100 hover:text-cyan-800 hover:shadow-sm transition-all duration-300 cursor-default">
