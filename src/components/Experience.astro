---

---

<section id="experience" class="py-20 bg-white">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-blue-900 mb-4">
        Nuestra Experiencia
      </h2>
      <div class="w-24 h-1 bg-blue-600 mx-auto mb-6"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-20">
      <div
        class="bg-white rounded-3xl p-10 text-center shadow-lg border border-purple-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
      >
        <div
          class="text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-700 to-blue-600 mb-4 group-hover:scale-110 transition-transform duration-300 inline-block"
        >
          400+
        </div>
        <div class="text-xl text-gray-800 font-bold mb-2">
          Estudios Clínicos
        </div>
        <p class="text-gray-500">Realizados desde 2011</p>
      </div>

      <div
        class="bg-white rounded-3xl p-10 text-center shadow-lg border border-purple-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
      >
        <div
          class="text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-700 mb-4 group-hover:scale-110 transition-transform duration-300 inline-block"
        >
          700+
        </div>
        <div class="text-xl text-gray-800 font-bold mb-2">
          Protocolos Diseñados
        </div>
        <p class="text-gray-500">Autorizados por COFEPRIS</p>
      </div>

      <div
        class="bg-white rounded-3xl p-10 text-center shadow-lg border border-purple-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group"
      >
        <div
          class="text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-700 to-indigo-600 mb-4 group-hover:scale-110 transition-transform duration-300 inline-block"
        >
          10+
        </div>
        <div class="text-xl text-gray-800 font-bold mb-2">
          Años de Experiencia
        </div>
        <p class="text-gray-500">Ininterrumpida en el sector</p>
      </div>
    </div>

    <div
      class="max-w-4xl mx-auto mb-20 bg-gradient-to-r from-blue-900 to-indigo-900 rounded-3xl p-12 shadow-2xl relative overflow-hidden text-center"
    >
      <div
        class="absolute top-0 right-0 w-64 h-64 bg-white opacity-5 rounded-full -mr-20 -mt-20"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-40 h-40 bg-white opacity-5 rounded-full -ml-10 -mb-10"
      >
      </div>

      <h3 class="text-3xl font-bold text-white mb-6 relative z-10">
        Nuestro Equipo
      </h3>
      <p class="text-xl text-purple-100 leading-relaxed relative z-10">
        Las y los médicos e investigadores de UNEBI suman a la organización más
        de 10 años de experiencia ininterrumpida en el sector médico y
        farmacéutico. Desde 2011, UNEBI ha realizado más de 400 estudios
        clínicos y diseñado más de 700 protocolos que han sido autorizados por
        la COFEPRIS. Lo anterior gracias a la labor de nuestro equipo de
        colaboradores, los cuales están comprometido con brindar servicios con
        calidad, en términos de confianza, rapidez, eficacia y seguridad.
      </p>
    </div>

    <div class="text-center mb-12">
      <h3 class="text-3xl md:text-4xl font-bold text-blue-900 mb-4">
        Principios Activos
      </h3>
      <p class="text-lg text-gray-600">
        Experiencia comprobada en diversas áreas terapéuticas
      </p>
    </div>

    <div class="max-w-6xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div
        class="bg-purple-50 rounded-2xl p-8 hover:bg-white hover:shadow-lg hover:border-purple-200 border border-transparent transition-all duration-300"
      >
        <h4
          class="font-bold text-purple-800 mb-4 text-xl flex items-center gap-2"
        >
          <span class="w-2 h-8 bg-purple-500 rounded-full"></span>
          Antivirales
        </h4>
        <div class="flex flex-wrap gap-2">
          <span
            class="bg-white border border-purple-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Abacavir</span
          >
          <span
            class="bg-white border border-purple-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Lamivudina</span
          >
          <span
            class="bg-white border border-purple-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Zidovudina</span
          >
          <span
            class="bg-white border border-purple-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Efavirenz</span
          >
        </div>
      </div>

      <div
        class="bg-blue-50 rounded-2xl p-8 hover:bg-white hover:shadow-lg hover:border-blue-200 border border-transparent transition-all duration-300"
      >
        <h4
          class="font-bold text-blue-800 mb-4 text-xl flex items-center gap-2"
        >
          <span class="w-2 h-8 bg-blue-500 rounded-full"></span>
          Cardiovasculares
        </h4>
        <div class="flex flex-wrap gap-2">
          <span
            class="bg-white border border-blue-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Amlodipino</span
          >
          <span
            class="bg-white border border-blue-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Atorvastatina</span
          >
          <span
            class="bg-white border border-blue-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Losartán</span
          >
        </div>
      </div>

      <div
        class="bg-indigo-50 rounded-2xl p-8 hover:bg-white hover:shadow-lg hover:border-indigo-200 border border-transparent transition-all duration-300"
      >
        <h4
          class="font-bold text-indigo-800 mb-4 text-xl flex items-center gap-2"
        >
          <span class="w-2 h-8 bg-indigo-500 rounded-full"></span>
          Antibióticos
        </h4>
        <div class="flex flex-wrap gap-2">
          <span
            class="bg-white border border-indigo-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Amoxicilina</span
          >
          <span
            class="bg-white border border-indigo-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Ciprofloxacino</span
          >
          <span
            class="bg-white border border-indigo-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Azitromicina</span
          >
        </div>
      </div>

      <div
        class="bg-purple-50 rounded-2xl p-8 hover:bg-white hover:shadow-lg hover:border-purple-200 border border-transparent transition-all duration-300"
      >
        <h4
          class="font-bold text-purple-800 mb-4 text-xl flex items-center gap-2"
        >
          <span class="w-2 h-8 bg-purple-500 rounded-full"></span>
          Antiinflamatorios
        </h4>
        <div class="flex flex-wrap gap-2">
          <span
            class="bg-white border border-purple-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Ibuprofeno</span
          >
          <span
            class="bg-white border border-purple-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Diclofenaco</span
          >
          <span
            class="bg-white border border-purple-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Celecoxib</span
          >
        </div>
      </div>

      <div
        class="bg-pink-50 rounded-2xl p-8 hover:bg-white hover:shadow-lg hover:border-pink-200 border border-transparent transition-all duration-300"
      >
        <h4
          class="font-bold text-pink-800 mb-4 text-xl flex items-center gap-2"
        >
          <span class="w-2 h-8 bg-pink-500 rounded-full"></span>
          Antidiabéticos
        </h4>
        <div class="flex flex-wrap gap-2">
          <span
            class="bg-white border border-pink-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Metformina</span
          >
          <span
            class="bg-white border border-pink-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Glibenclamida</span
          >
          <span
            class="bg-white border border-pink-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Sitagliptina</span
          >
        </div>
      </div>

      <div
        class="bg-blue-50 rounded-2xl p-8 hover:bg-white hover:shadow-lg hover:border-blue-200 border border-transparent transition-all duration-300"
      >
        <h4
          class="font-bold text-blue-800 mb-4 text-xl flex items-center gap-2"
        >
          <span class="w-2 h-8 bg-blue-500 rounded-full"></span>
          SNC / Psiquiátricos
        </h4>
        <div class="flex flex-wrap gap-2">
          <span
            class="bg-white border border-blue-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Sertralina</span
          >
          <span
            class="bg-white border border-blue-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Clonazepam</span
          >
          <span
            class="bg-white border border-blue-100 px-3 py-1 rounded-full text-sm text-gray-700 font-medium"
            >Pregabalina</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
