---

---

<section id="contact" class="py-20 bg-gray-50">
  <div class="container mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center max-w-6xl mx-auto">
      <div>
        <h2 class="text-4xl md:text-5xl font-bold text-blue-900 mb-6">
          Contáctanos
        </h2>
        <div class="w-24 h-1 bg-blue-600 mb-8"></div>
        <p class="text-xl text-gray-700 leading-relaxed mb-10 font-medium">
          ¿Interesado en realizar un estudio clínico o bioequivalencia? <br />
          Nuestro equipo de expertos está listo para asesorarte en cada etapa del
          proceso regulatorio y clínico.
        </p>

        <a
          href="mailto:info@unebi.com.mx"
          class="inline-flex items-center gap-3 bg-blue-700 text-white px-8 py-4 rounded-full font-bold text-lg shadow-xl shadow-purple-200 hover:bg-blue-800 hover:-translate-y-1 transition-all duration-300 group"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path></svg
          >
          Mándanos un correo
          <svg
            class="w-5 h-5 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
          >
        </a>
      </div>

      <div
        class="bg-white rounded-3xl p-10 shadow-2xl border border-purple-100 relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 w-32 h-32 bg-purple-50 rounded-bl-full -mr-4 -mt-4 opacity-50"
        >
        </div>

        <div class="space-y-8 relative z-10">
          <div class="flex items-start gap-5">
            <div
              class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center text-purple-600"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path></svg
              >
            </div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-1">
                Correo Electrónico
              </h3>
              <a
                href="mailto:info@unebi.com.mx"
                class="text-purple-700 hover:text-purple-900 font-medium transition-colors"
              >
                info@unebi.com.mx
              </a>
            </div>
          </div>

          <div class="flex items-start gap-5">
            <div
              class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center text-blue-600"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path></svg
              >
            </div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-1">Teléfono</h3>
              <div class="flex flex-col gap-1">
                <a class="text-gray-600 hover:text-purple-700 transition-colors"
                  >33 3606 6957</a
                >
              </div>
            </div>
          </div>

          <div class="flex items-start gap-5">
            <div
              class="flex-shrink-0 w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
              >
            </div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-1">Ubicación</h3>
              <p class="text-gray-600 leading-snug">
                Av. Alemania 1361, Col. Moderna<br />
                C.P. 44190, Guadalajara, Jalisco.
              </p>
              <a
                href="https://maps.google.com/?q=Av.+Alemania+1361,+Guadalajara"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-bold text-purple-600 hover:text-purple-800 mt-2 inline-block underline"
              >
                Ver en Google Maps
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
