---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white py-16 relative overflow-hidden">
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div
      class="absolute -top-24 -left-24 w-96 h-96 bg-cyan-900/40 rounded-full blur-[80px]"
    >
    </div>
    <div
      class="absolute -bottom-24 -right-24 w-96 h-96 bg-blue-900/30 rounded-full blur-[80px]"
    >
    </div>
  </div>

  <div
    id="footer-particles"
    class="absolute inset-0 z-0 pointer-events-none opacity-40"
  >
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-1">
        <div class="flex items-center gap-2 mb-6">
          <a
            href="#"
            class="flex items-center gap-2 flex-shrink-0 group relative"
          >
            <img
              id="logo-white"
              src="/UNEBI_LogoBlanco4.png"
              alt="UNEBI Logo Blanco"
              class="h-10 md:h-14 w-auto object-contain transition-transform duration-300 group-hover:scale-105 block"
            />
          </a>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          Calidad, confianza y velocidad en estudios clínicos. Comprometidos con
          la salud y el avance científico.
        </p>
        <div class="flex gap-4">
          <a
            href="https://www.facebook.com/AndreaRH.GrupoCinasiUnebi"
            class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-cyan-600 hover:scale-110 transition-all duration-300"
          >
            <span class="sr-only">Facebook</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.linkedin.com/company/cinasi/posts/?feedView=all"
            class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-cyan-600 hover:scale-110 transition-all duration-300"
          >
            <span class="sr-only">LinkedIn</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 21.227.792 22 1.771 22h20.451C23.2 22 24 21.227 24 20.271V1.729C24 .774 23.2 0 22.225 0z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <div>
        <h4
          class="text-lg font-bold text-white mb-6 border-b border-cyan-500 pb-2 inline-block"
        >
          Enlaces
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="#home"
              class="text-gray-400 hover:text-cyan-400 transition-colors text-sm hover:translate-x-1 inline-block"
              >Inicio</a
            >
          </li>
          <li>
            <a
              href="#about"
              class="text-gray-400 hover:text-cyan-400 transition-colors text-sm hover:translate-x-1 inline-block"
              >Nosotros</a
            >
          </li>
          <li>
            <a
              href="#services"
              class="text-gray-400 hover:text-cyan-400 transition-colors text-sm hover:translate-x-1 inline-block"
              >Servicios</a
            >
          </li>
          <li>
            <a
              href="#facilities"
              class="text-gray-400 hover:text-cyan-400 transition-colors text-sm hover:translate-x-1 inline-block"
              >Instalaciones</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4
          class="text-lg font-bold text-white mb-6 border-b border-cyan-500 pb-2 inline-block"
        >
          Servicios
        </h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="hover:text-white transition-colors cursor-default">
            Bioequivalencia
          </li>
          <li class="hover:text-white transition-colors cursor-default">
            Fases Clínicas I-IV
          </li>
          <li class="hover:text-white transition-colors cursor-default">
            Farmacocinética
          </li>
          <li class="hover:text-white transition-colors cursor-default">
            Farmacovigilancia
          </li>
        </ul>
      </div>

      <div>
        <h4
          class="text-lg font-bold text-white mb-6 border-b border-cyan-500 pb-2 inline-block"
        >
          Contacto
        </h4>
        <ul class="space-y-4 text-sm text-gray-400">
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-cyan-500 mt-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path></svg
            >
            <a
              href="mailto:info@unebi.com.mx"
              class="hover:text-white transition-colors">info@unebi.com.mx</a
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="w-5 h-5 text-cyan-500 mt-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path></svg
            >
            <div class="flex flex-col">
              <a class="hover:text-white transition-colors">33 3606 6957</a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              class="w-5 h-5 text-cyan-500"
              stroke-linejoin="round"
              ><path
                d="M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 0C1.46 6.7 1.33 10.28 4 13l8 8 8-8c2.67-2.72 2.54-6.3.42-8.42z"
              ></path></svg
            >
            <div class="flex flex-col">
              <a class="hover:text-white transition-colors" href="#voluntario"
                >Participar como voluntario</a
              >
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-5 h-5 text-cyan-500"
              ><rect x="2" y="7" width="20" height="14" rx="2" ry="2"
              ></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"
              ></path></svg
            >
            <div class="flex flex-col">
              <a class="hover:text-white transition-colors" href="#voluntario"
                >Postúlate a UNEBI</a
              >
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-gray-500 text-sm text-center md:text-left">
        © {currentYear} UNEBI. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<button
  id="back-to-top"
  class="fixed bottom-8 right-8 bg-cyan-600 text-white p-4 rounded-full shadow-2xl hover:bg-cyan-700 transition-all duration-300 opacity-0 translate-y-10 pointer-events-none z-50 animate-soft-pulse group"
  aria-label="Volver arriba"
>
  <svg
    class="w-6 h-6 group-hover:-translate-y-1 transition-transform duration-300"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="3"
      d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
  </svg>
</button>

<script>
  // Back to Top Logic
  const backToTopButton = document.getElementById("back-to-top");
  if (backToTopButton) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 400) {
        backToTopButton.classList.remove(
          "opacity-0",
          "translate-y-10",
          "pointer-events-none",
        );
      } else {
        backToTopButton.classList.add(
          "opacity-0",
          "translate-y-10",
          "pointer-events-none",
        );
      }
    });
    backToTopButton.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  // Footer Particles Logic
  import { tsParticles } from "@tsparticles/engine";
  import { loadFull } from "tsparticles";

  (async () => {
    await loadFull(tsParticles);

    // CORRECCIÓN: Se pasa un solo objeto con 'id' y 'options' dentro
    await tsParticles.load({
      id: "footer-particles",
      options: {
        fullScreen: { enable: false },
        particles: {
          number: { value: 30, density: { enable: true, width: 800 } },
          // Partículas blancas y Cyan
          color: { value: ["#ffffff", "#22d3ee"] },
          shape: { type: "circle" },
          opacity: { value: 0.3 },
          size: { value: { min: 1, max: 3 } },
          move: {
            enable: true,
            speed: 0.5,
            direction: "none",
            outModes: "out",
          },
          links: {
            enable: true,
            distance: 150,
            color: "#ffffff",
            opacity: 0.1,
            width: 1,
          },
        },
        background: { color: "transparent" },
      },
    });
  })();
</script>
