---
const navItems = [
  { name: "Inicio", href: "#home" },
  { name: "Nosotros", href: "#about" },
  { name: "Servicios", href: "#services" },
  { name: "Instalaciones", href: "#facilities" },
  { name: "Experiencia", href: "#experience" },
];
---

<header
  id="main-header"
  class="fixed w-full top-0 z-50 transition-all duration-500 bg-transparent py-6"
>
  <nav class="container mx-auto px-6">
    <div class="flex items-center justify-between gap-4">
      <a href="#" class="flex items-center gap-2 flex-shrink-0 group relative">
        <img
          id="logo-white"
          src="/UNEBI_LogoBlanco4.png"
          alt="UNEBI Logo Blanco"
          class="h-10 md:h-14 w-auto object-contain transition-transform duration-300 group-hover:scale-105 block"
        />

        <img
          id="logo-purple"
          src="/UNEBI_LogoMorado4.png"
          alt="UNEBI Logo Color"
          class="h-10 md:h-14 w-auto object-contain transition-transform duration-300 group-hover:scale-105 hidden"
        />
      </a>

      <ul class="hidden xl:flex items-center space-x-8">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link text-sm font-bold text-black hover:text-white transition-colors relative group"
              >
                {item.name}
                <span class="absolute left-0 bottom-[-4px] w-0 h-0.5 bg-cyan-400 transition-all duration-300 group-hover:w-full" />
              </a>
            </li>
          ))
        }

        <li>
          <a
            href="mailto:info@unebi.com.mx"
            class="bg-cyan-600 text-white px-6 py-2.5 rounded-full font-bold shadow-lg shadow-cyan-900/20 hover:bg-cyan-700 hover:shadow-cyan-500/40 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap"
          >
            Contacto
          </a>
        </li>
      </ul>

      <button
        id="mobile-menu-btn"
        class="xl:hidden text-white focus:outline-none p-2 rounded-lg hover:bg-white/10 transition-colors"
        aria-label="Abrir menú"
      >
        <svg
          class="w-8 h-8"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="hidden xl:hidden bg-white/95 backdrop-blur-md rounded-2xl shadow-xl mt-4 p-6 border border-cyan-100 absolute w-[calc(100%-3rem)] left-6"
    >
      <ul class="flex flex-col space-y-4">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="block text-gray-700 hover:text-cyan-700 font-semibold text-lg px-2 border-l-4 border-transparent hover:border-cyan-600 hover:bg-cyan-50 transition-all duration-300 py-2"
              >
                {item.name}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <a
            href="mailto:info@unebi.com.mx"
            class="block w-full text-center bg-cyan-600 text-white px-6 py-3 rounded-xl font-bold shadow-md hover:bg-cyan-700 transition-all duration-300"
          >
            Contacto
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const header = document.getElementById("main-header");
  const logoWhite = document.getElementById("logo-white");
  const logoPurple = document.getElementById("logo-purple");
  const navLinks = document.querySelectorAll(".nav-link");

  // Toggle Menú Móvil
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
    // Cerrar al hacer click en enlace
    const menuLinks = mobileMenu.querySelectorAll("a");
    menuLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
      });
    });
  }

  // --- LÓGICA DE SCROLL (Cambio de Header) ---
  window.addEventListener("scroll", () => {
    if (header && logoWhite && logoPurple && mobileMenuBtn) {
      if (window.scrollY > 80) {
        // 1. ESTADO: SCROLL BAJADO (Header Blanco)

        // Fondo y forma del header
        header.classList.remove("bg-transparent", "py-6");
        header.classList.add(
          "bg-white/95",
          "backdrop-blur-md",
          "shadow-md",
          "border-b",
          "border-cyan-100",
          "py-3",
        );

        // Cambio de Logo: Ocultar Blanco, Mostrar Color
        logoWhite.classList.add("hidden");
        logoWhite.classList.remove("block");
        logoPurple.classList.add("block");
        logoPurple.classList.remove("hidden");

        // Cambio de Color de Texto (Enlaces) -> Gris Oscuro
        navLinks.forEach((link) => {
          link.classList.remove("text-white/90", "hover:text-white");
          link.classList.add("text-gray-600", "hover:text-cyan-700");
        });

        // Botón Móvil -> Cyan
        mobileMenuBtn.classList.remove("text-white", "hover:bg-white/10");
        mobileMenuBtn.classList.add("text-cyan-900", "hover:bg-cyan-50");
      } else {
        // 2. ESTADO: EN EL HERO (Header Transparente)

        // Fondo y forma original
        header.classList.add("bg-transparent", "py-6");
        header.classList.remove(
          "bg-white/95",
          "backdrop-blur-md",
          "shadow-md",
          "border-b",
          "border-cyan-100",
          "py-3",
        );
        // Cambio de Logo: Mostrar Blanco, Ocultar Color
        logoWhite.classList.add("block");
        logoWhite.classList.remove("hidden");
        logoPurple.classList.add("hidden");
        logoPurple.classList.remove("block");
        // Cambio de Color de Texto (Enlaces) -> Blanco
        navLinks.forEach((link) => {
          link.classList.add("text-white/90", "hover:text-white");
          link.classList.remove("text-gray-600", "hover:text-cyan-700");
        });
        // Botón Móvil -> Blanco
        mobileMenuBtn.classList.add("text-white", "hover:bg-white/10");
        mobileMenuBtn.classList.remove("text-cyan-900", "hover:bg-cyan-50");
      }
    }
  });
</script>
