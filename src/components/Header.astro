---
const navItems = [
  { name: "Inicio", href: "#home" },
  { name: "Nosotros", href: "#about" },
  { name: "Servicios", href: "#services" },
  { name: "Instalaciones", href: "#facilities" },
  { name: "Experiencia", href: "#experience" },
];
---

<header
  id="main-header"
  class="fixed w-full top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm border-b border-purple-100 transition-all duration-300"
>
  <nav class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between gap-4">
      <a href="#" class="flex items-center gap-2 flex-shrink-0 group">
        <img
          src="/UNEBI_LogoMorado4.png"
          alt="UNEBI Logo"
          class="h-10 md:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        />
      </a>

      <ul class="hidden xl:flex items-center space-x-8">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm font-bold text-gray-600 hover:text-purple-700 transition-colors relative group"
              >
                {item.name}
                <span class="absolute left-0 bottom-[-4px] w-0 h-0.5 bg-purple-600 transition-all duration-300 group-hover:w-full" />
              </a>
            </li>
          ))
        }

        <li>
          <a
            href="#contact"
            class="bg-purple-700 text-white px-6 py-2.5 rounded-full font-bold shadow-lg shadow-purple-200 hover:bg-purple-800 hover:shadow-purple-300 hover:-translate-y-0.5 transition-all duration-300 whitespace-nowrap"
          >
            Contacto
          </a>
        </li>
      </ul>

      <button
        id="mobile-menu-btn"
        class="xl:hidden text-purple-900 focus:outline-none p-2 rounded-lg hover:bg-purple-50 transition-colors"
        aria-label="Abrir menú"
      >
        <svg
          class="w-7 h-7"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="hidden xl:hidden pt-6 pb-4 border-t border-gray-100 mt-4"
    >
      <ul class="flex flex-col space-y-4">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="block text-gray-700 hover:text-purple-700 font-semibold text-lg px-2 border-l-4 border-transparent hover:border-purple-600 hover:bg-purple-50 transition-all duration-300 py-2"
              >
                {item.name}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <a
            href="#contact"
            class="block w-full text-center bg-purple-700 text-white px-6 py-3 rounded-xl font-bold shadow-md hover:bg-purple-800 transition-all duration-300"
          >
            Contacto
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const header = document.getElementById("main-header");

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
      // Animación simple de opacidad si quisieras agregarla
      if (!mobileMenu.classList.contains("hidden")) {
        mobileMenu.classList.add("animate-fadeIn");
      }
    });

    // Close menu when clicking on a link
    const menuLinks = mobileMenu.querySelectorAll("a");
    menuLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
      });
    });
  }

  // Change header background/shadow on scroll
  window.addEventListener("scroll", () => {
    if (header) {
      if (window.scrollY > 20) {
        header.classList.add("shadow-lg", "py-2"); // Más compacto al bajar
        header.classList.remove("py-4");
      } else {
        header.classList.remove("shadow-lg", "py-2");
        header.classList.add("py-4"); // Más espacioso arriba
      }
    }
  });
</script>
