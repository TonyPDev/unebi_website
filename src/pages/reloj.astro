---
// src/pages/reloj.astro
// Pantalla NVR + Video Hardware Local
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reloj Rack - UNEBI</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #000000;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        overflow: hidden;
        /* Usamos la fuente nativa monoespaciada para evitar el error de red de dseg.min.css */
        font-family: "Courier New", Courier, monospace;
      }

      .reloj-contenedor {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 3vh;
      }

      .led-fondo {
        position: absolute;
        color: rgba(255, 0, 0, 0.08);
        font-size: 16vw;
        font-weight: bold;
        line-height: 1;
        z-index: 1;
        user-select: none;
      }

      #reloj-digital {
        position: relative;
        color: #ff0000;
        font-size: 16vw;
        font-weight: bold;
        line-height: 1;
        z-index: 2;
        user-select: none;
      }

      #fecha-actual {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        font-size: 2.2vw;
        font-weight: 700;
        color: #ff3333;
        letter-spacing: 3px;
        text-transform: uppercase;
        opacity: 0.85;
      }

      /* Ocultamos el video real pero sin usar display:none para que el hardware sí lo procese */
      .hardware-video {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0.01;
        pointer-events: none;
        z-index: -1;
      }
    </style>
  </head>
  <body>
    <video
      class="hardware-video"
      src="/video-vacio.mp4"
      autoplay
      loop
      muted
      playsinline
    >
    </video>

    <div class="reloj-contenedor">
      <div class="led-fondo">88:88:88</div>
      <div id="reloj-digital">00:00:00</div>
    </div>

    <div id="fecha-actual">CARGANDO FECHA...</div>

    <script>
      (() => {
        // Ajuste manual
        const AJUSTE_SEGUNDOS = -0.5;
        const desfaseFijo = AJUSTE_SEGUNDOS * 1000;

        function actualizarReloj() {
          const ahora = new Date(Date.now() + desfaseFijo);
          const horas = String(ahora.getHours()).padStart(2, "0");
          const minutos = String(ahora.getMinutes()).padStart(2, "0");
          const segundos = String(ahora.getSeconds()).padStart(2, "0");

          const relojDigital = document.getElementById("reloj-digital");
          if (relojDigital)
            relojDigital.textContent = `${horas}:${minutos}:${segundos}`;

          const opcionesFecha = {
            weekday: "long",
            year: "numeric",
            month: "long",
            day: "numeric",
          } as const;
          let fechaTexto = ahora.toLocaleDateString("es-MX", opcionesFecha);

          const fechaActual = document.getElementById("fecha-actual");
          if (fechaActual) fechaActual.textContent = fechaTexto.toUpperCase();
        }

        setInterval(actualizarReloj, 1000);
        actualizarReloj();
      })();
    </script>
  </body>
</html>
